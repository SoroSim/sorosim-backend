{
  "name": "sorosim-backend",
  "version": "1.0.0",
  "description": "Soroban Contract Simulation & Dry-Run Sandbox Backend",
  "main": "dist/index.js",
  "bin": {
    "sorosim": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "build:cli": "tsc && chmod +x dist/cli/index.js || echo Done",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "start": "node dist/index.js",
    "cli": "ts-node src/cli/index.ts",
    "lint": "eslint src --ext .ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "ci:local": "npm run lint && npm run build && npm test"
  },
  "keywords": [
    "soroban",
    "stellar",
    "blockchain",
    "simulation",
    "cli"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@stellar/stellar-sdk": "^17.0.1",
    "axios": "^1.7.9",
    "chalk": "4.1.2",
    "commander": "^12.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "form-data": "^4.0.6",
    "multer": "^2.2.0",
    "uuid": "^14.0.2",
    "wasmparser": "^5.11.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/form-data": "^2.2.1",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.19.43",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "jest": "^30.5.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
